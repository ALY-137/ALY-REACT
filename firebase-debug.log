[debug] [2026-02-27T11:11:16.389Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/aly-onepages-runtime/rulesets {"name":"projects/aly-onepages-runtime/rulesets/0da6fb6e-604f-4938-9ed8-049b05d9b8dd","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function hasSistemaConfig() {\n      return exists(/databases/$(database)/documents/add_ons/sistema_config);\n    }\n\n    function isAdminDinamico() {\n      return signedIn() &&\n        hasSistemaConfig() &&\n        (get(/databases/$(database)/documents/add_ons/sistema_config).data.adminUid is string) &&\n        request.auth.uid == get(/databases/$(database)/documents/add_ons/sistema_config).data.adminUid;\n    }\n\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function isAdmin() {\n      return signedIn() && (\n        request.auth.uid == \"WnGJjmU6btgKmMMFAQq5Hpupsap1\" ||\n        isAdminDinamico()\n      );\n    }\n\n    function isOwner(userId) {\n      return signedIn() && request.auth.uid == userId;\n    }\n\n    function hasOwnSkin(skinId) {\n      return signedIn() &&\n        exists(/databases/$(database)/documents/users/$(request.auth.uid)/skins/$(skinId));\n    }\n\n    function hasActiveSkinId() {\n      return signedIn() &&\n        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&\n        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.skinAtivaId is string);\n    }\n\n    function activeSkinId() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.skinAtivaId;\n    }\n\n    function isSelfOrOwnSkinId(refId) {\n      return signedIn() && (refId == request.auth.uid || hasOwnSkin(refId));\n    }\n\n    function canReadPublic(visibilidade) {\n      return visibilidade == null ||\n        visibilidade == \"publico\" ||\n        ((visibilidade == \"publico_restritivo\" || visibilidade == \"privado\") && signedIn());\n    }\n\n    function canReadSkin(userId, skinId) {\n      return isAdmin() ||\n        isOwner(userId) ||\n        (\n          exists(/databases/$(database)/documents/users/$(userId)/skins/$(skinId)) &&\n          canReadPublic(\n            get(/databases/$(database)/documents/users/$(userId)/skins/$(skinId)).data.visibilidade\n          )\n        );\n    }\n\n    function isEspacoCoCriadorData(data) {\n      return signedIn() &&\n        (data.coCriadoresUids is list) &&\n        data.coCriadoresUids.hasAny([request.auth.uid]);\n    }\n\n    function canManageEspacoData(data, userId) {\n      return isAdmin() || isOwner(userId) || isEspacoCoCriadorData(data);\n    }\n\n    function canManageEspacoByPath(userId, espacoId) {\n      return exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)) &&\n        canManageEspacoData(\n          get(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)).data,\n          userId\n        );\n    }\n\n    function isEspacoAssinante(userId, espacoId) {\n      return signedIn() && (\n        exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/assinantes/$(request.auth.uid)) ||\n        (hasActiveSkinId() &&\n          exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/assinantes/$(activeSkinId())))\n      );\n    }\n\n    function canReadEspacoData(data, userId, espacoId) {\n      return canManageEspacoData(data, userId) ||\n        data.visibilidade == null ||\n        data.visibilidade == \"publico\" ||\n        ((data.visibilidade == \"publico_restritivo\" || data.visibilidade == \"privado\") && signedIn()) ||\n        (data.visibilidade == \"exclusivo_assinante\" && isEspacoAssinante(userId, espacoId));\n    }\n\n    function isBlocoCoCriador(data) {\n      return signedIn() &&\n        (data.coCriadoresUids is list) &&\n        data.coCriadoresUids.hasAny([request.auth.uid]);\n    }\n\n    function canManageBlocoData(data) {\n      return isAdmin() ||\n        (signedIn() && (\n          data.criadoPor == request.auth.uid ||\n          isBlocoCoCriador(data)\n        ));\n    }\n\n    function isLegacyBlocoComprador(blocoId) {\n      return signedIn() && (\n        exists(/databases/$(database)/documents/blocos/$(blocoId)/compradores/$(request.auth.uid)) ||\n        (hasActiveSkinId() &&\n          exists(/databases/$(database)/documents/blocos/$(blocoId)/compradores/$(activeSkinId())))\n      );\n    }\n\n    function isEspacoBlocoComprador(userId, espacoId, blocoId) {\n      return signedIn() && (\n        exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)/compradores/$(request.auth.uid)) ||\n        (hasActiveSkinId() &&\n          exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)/compradores/$(activeSkinId())))\n      );\n    }\n\n    function canReadLegacyBlocoData(data, blocoId) {\n      return canManageBlocoData(data) ||\n        data.visibilidade == null ||\n        data.visibilidade == \"publico\" ||\n        data.visibilidade == \"publico_restritivo\" ||\n        data.visibilidade == \"privado\" ||\n        data.visibilidade == \"exclusivo_assinante\" ||\n        data.visibilidade == \"exclusivo_comprador\" ||\n        data.visibilidade == \"comprado\";\n    }\n\n    function canReadEspacoBlocoData(data, userId, espacoId, blocoId) {\n      return canManageEspacoByPath(userId, espacoId) ||\n        canManageBlocoData(data) ||\n        (\n          exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)) &&\n          canReadEspacoData(\n            get(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)).data,\n            userId,\n            espacoId\n          ) &&\n          (\n            data.visibilidade == null ||\n            data.visibilidade == \"publico\" ||\n            data.visibilidade == \"publico_restritivo\" ||\n            data.visibilidade == \"privado\" ||\n            data.visibilidade == \"exclusivo_assinante\" ||\n            data.visibilidade == \"exclusivo_comprador\" ||\n            data.visibilidade == \"comprado\"\n          )\n        );\n    }\n\n    function isOnePagePublicMode() {\n      return hasSistemaConfig() &&\n        (get(/databases/$(database)/documents/add_ons/sistema_config).data.tipoExperiencia is string) &&\n        get(/databases/$(database)/documents/add_ons/sistema_config).data.tipoExperiencia == \"onepage\" &&\n        (get(/databases/$(database)/documents/add_ons/sistema_config).data.modoAcessoProjeto is string) &&\n        get(/databases/$(database)/documents/add_ons/sistema_config).data.modoAcessoProjeto == \"publico_sem_login\";\n    }\n\n    function canWriteBlocosNoProjetoAtual() {\n      return !isOnePagePublicMode() || isAdmin();\n    }\n\n    function canCreateEspacoBloco(userId, espacoId, data) {\n      return signedIn() &&\n        canWriteBlocosNoProjetoAtual() &&\n        canManageEspacoByPath(userId, espacoId) &&\n        (!('espacoId' in data) || data.espacoId == espacoId) &&\n        (!('ownerUserId' in data) || data.ownerUserId == userId) &&\n        (!('criadoPor' in data) || data.criadoPor == request.auth.uid);\n    }\n\n    function canManageLegacyBloco(blocoId) {\n      return exists(/databases/$(database)/documents/blocos/$(blocoId)) &&\n        canManageBlocoData(get(/databases/$(database)/documents/blocos/$(blocoId)).data);\n    }\n\n    match /users/{userId} {\n      allow read: if isAdmin() || isOwner(userId);\n      allow create: if isAdmin() || isOwner(userId);\n      allow update, delete: if isAdmin() || isOwner(userId);\n\n      match /logins/{loginId} {\n        allow read, write: if isAdmin() || isOwner(userId);\n      }\n\n      match /navegacoes_users/{sessaoId} {\n        allow read, write: if isAdmin() || isOwner(userId);\n      }\n\n      match /skins/{skinId} {\n        allow get, list: if isAdmin() ||\n          isOwner(userId) ||\n          (signedIn() && resource.data.ownerUserId == request.auth.uid) ||\n          canReadPublic(resource.data.visibilidade);\n        allow create: if isAdmin() ||\n          (isOwner(userId) && request.resource.data.ownerUserId == userId);\n        allow update, delete: if isAdmin() || isOwner(userId);\n\n        match /{subPath=**} {\n          allow read: if canReadSkin(userId, skinId);\n          allow write: if isAdmin() || isOwner(userId);\n        }\n      }\n\n      match /espacos/{espacoId} {\n        allow get, list: if canReadEspacoData(resource.data, userId, espacoId);\n        allow create: if isAdmin() ||\n          (isOwner(userId) &&\n            (!('ownerUserId' in request.resource.data) || request.resource.data.ownerUserId == userId));\n        allow update, delete: if canManageEspacoData(resource.data, userId);\n\n        match /blocos/{blocoId} {\n          allow get, list: if canReadEspacoBlocoData(resource.data, userId, espacoId, blocoId);\n          allow create: if isAdmin() || canCreateEspacoBloco(userId, espacoId, request.resource.data);\n          allow update, delete: if isAdmin() ||\n            (canWriteBlocosNoProjetoAtual() && (\n            canManageEspacoByPath(userId, espacoId) ||\n            canManageBlocoData(resource.data)\n            ));\n\n          match /cards/{cardId} {\n            allow read: if exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)) &&\n              canReadEspacoBlocoData(\n                get(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)).data,\n                userId,\n                espacoId,\n                blocoId\n              );\n            allow create, update, delete: if isAdmin() ||\n              (canWriteBlocosNoProjetoAtual() && (\n              canManageEspacoByPath(userId, espacoId) ||\n              (\n                exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)) &&\n                canManageBlocoData(\n                  get(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)).data\n                )\n              )\n              ));\n\n            match /addOnsRefs/{addOnRefId} {\n              allow read: if exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)) &&\n                canReadEspacoBlocoData(\n                  get(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)).data,\n                  userId,\n                  espacoId,\n                  blocoId\n                );\n              allow create, update, delete: if isAdmin() ||\n                (canWriteBlocosNoProjetoAtual() && (\n                canManageEspacoByPath(userId, espacoId) ||\n                (\n                  exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)) &&\n                  canManageBlocoData(\n                    get(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)).data\n                  )\n                )\n                ));\n            }\n          }\n\n          match /compradores/{compradorId} {\n            allow read: if canManageEspacoByPath(userId, espacoId) || isSelfOrOwnSkinId(compradorId);\n            allow create, delete: if canManageEspacoByPath(userId, espacoId) || isSelfOrOwnSkinId(compradorId);\n            allow update: if canManageEspacoByPath(userId, espacoId);\n          }\n        }\n\n        match /assinantes/{assinanteId} {\n          allow read: if canManageEspacoByPath(userId, espacoId) || isSelfOrOwnSkinId(assinanteId);\n          allow create, delete: if canManageEspacoByPath(userId, espacoId) || isSelfOrOwnSkinId(assinanteId);\n          allow update: if canManageEspacoByPath(userId, espacoId);\n        }\n      }\n    }\n\n    match /blocos/{blocoId} {\n      allow read: if canReadLegacyBlocoData(resource.data, blocoId);\n      allow create: if canWriteBlocosNoProjetoAtual() &&\n        signedIn() &&\n        (isAdmin() || request.resource.data.criadoPor == request.auth.uid);\n      allow update, delete: if canWriteBlocosNoProjetoAtual() &&\n        canManageBlocoData(resource.data);\n\n      match /cards/{cardId} {\n        allow read: if exists(/databases/$(database)/documents/blocos/$(blocoId)) &&\n          canReadLegacyBlocoData(\n            get(/databases/$(database)/documents/blocos/$(blocoId)).data,\n            blocoId\n          );\n        allow create, update, delete: if canWriteBlocosNoProjetoAtual() &&\n          canManageLegacyBloco(blocoId);\n\n        match /addOnsRefs/{addOnRefId} {\n          allow read: if exists(/databases/$(database)/documents/blocos/$(blocoId)) &&\n            canReadLegacyBlocoData(\n              get(/databases/$(database)/documents/blocos/$(blocoId)).data,\n              blocoId\n            );\n          allow create, update, delete: if canWriteBlocosNoProjetoAtual() &&\n            canManageLegacyBloco(blocoId);\n        }\n      }\n\n      match /compradores/{compradorId} {\n        allow read: if canManageLegacyBloco(blocoId) || isSelfOrOwnSkinId(compradorId);\n        allow create, delete: if canManageLegacyBloco(blocoId) || isSelfOrOwnSkinId(compradorId);\n        allow update: if canManageLegacyBloco(blocoId);\n      }\n    }\n\n    match /contatos/{contatoId} {\n      allow create: if true;\n      allow read, update, delete: if isAdmin() || signedIn();\n\n      match /conversas/{conversaId} {\n        allow create: if true;\n        allow read, update, delete: if isAdmin() || signedIn();\n\n        match /chat/{chatId} {\n          allow create: if true;\n          allow read, update, delete: if isAdmin() || signedIn();\n        }\n\n        // Compatibilidade com legado que ainda usa \"chats\".\n        match /chats/{chatId} {\n          allow create: if true;\n          allow read, update, delete: if isAdmin() || signedIn();\n        }\n      }\n    }\n\n    match /acessos/{acessoId} {\n      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;\n      allow read, update, delete: if isAdmin();\n    }\n\n        match /add_ons/{addonId} {\n      allow read: if true;\n      allow create: if isAdmin() || (\n        addonId == \"sistema_config\" &&\n        signedIn() &&\n        !hasSistemaConfig() &&\n        request.resource.data.adminUid == request.auth.uid\n      );\n      allow update, delete: if isAdmin();\n    }\n\n    // Cadastro central de sistemas (projeto gerenciador).\n    // Leitura publica para carregar configuracoes globais sem login.\n    match /systems/{systemId} {\n      allow read: if true;\n      allow create: if isAdmin() || (\n        signedIn() &&\n        (request.resource.data.criadoPorUid is string) &&\n        request.resource.data.criadoPorUid == request.auth.uid &&\n        (request.resource.data.atualizadoPorUid is string) &&\n        request.resource.data.atualizadoPorUid == request.auth.uid\n      );\n      allow update, delete: if isAdmin() || (\n        signedIn() &&\n        (\n          (\n            (resource.data.criadoPorUid is string) &&\n            resource.data.criadoPorUid == request.auth.uid\n          ) ||\n          (\n            !(resource.data.criadoPorUid is string) &&\n            (request.resource.data.criadoPorUid is string) &&\n            request.resource.data.criadoPorUid == request.auth.uid &&\n            (request.resource.data.atualizadoPorUid is string) &&\n            request.resource.data.atualizadoPorUid == request.auth.uid\n          )\n        )\n      );\n    }\n\n    // Necessario para consultas collectionGroup(\"skins\")\n    // em qualquer profundidade de caminho.\n    match /{path=**}/skins/{skinId} {\n      allow get, list: if isAdmin() ||\n        (signedIn() && resource.data.ownerUserId == request.auth.uid) ||\n        canReadPublic(resource.data.visibilidade);\n    }\n\n    match /{doc=**} {\n      allow read, write: if false;\n    }\n  }\n}\n\r\n\r\n","name":"firestore.rules"}]},"createTime":"2026-02-27T11:11:16.039183Z","metadata":{"services":["cloud.firestore"]}}
