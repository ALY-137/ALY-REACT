# ALY-REACT Environment Variables Template
# ⚠️ NEVER commit .env.local or actual credentials to git!
# Copy this file to .env.local and fill in your values locally.

# Firebase Projects Configuration
# These should be obtained from your Firebase Console for each project

# Project 1: ALY OnePages Runtime
REACT_APP_FIREBASE_ALY_ONEPAGES_RUNTIME_KEY=aly-onepages-runtime
REACT_APP_FIREBASE_ALY_ONEPAGES_RUNTIME_API_KEY=your_api_key_here
REACT_APP_FIREBASE_ALY_ONEPAGES_RUNTIME_AUTH_DOMAIN=your_auth_domain_here
REACT_APP_FIREBASE_ALY_ONEPAGES_RUNTIME_PROJECT_ID=your_project_id_here
REACT_APP_FIREBASE_ALY_ONEPAGES_RUNTIME_STORAGE_BUCKET=your_storage_bucket_here
REACT_APP_FIREBASE_ALY_ONEPAGES_RUNTIME_MESSAGING_SENDER_ID=your_sender_id_here
REACT_APP_FIREBASE_ALY_ONEPAGES_RUNTIME_APP_ID=your_app_id_here
REACT_APP_FIREBASE_ALY_ONEPAGES_RUNTIME_FUNCTIONS_REGION=us-central1
REACT_APP_FIREBASE_ALY_ONEPAGES_RUNTIME_VAPID_KEY=your_vapid_key_here

# Project 2: Obeyon
REACT_APP_FIREBASE_OBEYON_API_KEY=your_api_key_here
REACT_APP_FIREBASE_OBEYON_AUTH_DOMAIN=your_auth_domain_here
REACT_APP_FIREBASE_OBEYON_PROJECT_ID=your_project_id_here
REACT_APP_FIREBASE_OBEYON_STORAGE_BUCKET=your_storage_bucket_here
REACT_APP_FIREBASE_OBEYON_MESSAGING_SENDER_ID=your_sender_id_here
REACT_APP_FIREBASE_OBEYON_APP_ID=your_app_id_here

# Project 3: Gerenciador ALY
REACT_APP_FIREBASE_GERENCIADOR_ALY_KEY=gerenciador-aly
REACT_APP_FIREBASE_GERENCIADOR_ALY_API_KEY=your_api_key_here
REACT_APP_FIREBASE_GERENCIADOR_ALY_AUTH_DOMAIN=your_auth_domain_here
REACT_APP_FIREBASE_GERENCIADOR_ALY_PROJECT_ID=your_project_id_here
REACT_APP_FIREBASE_GERENCIADOR_ALY_STORAGE_BUCKET=your_storage_bucket_here
REACT_APP_FIREBASE_GERENCIADOR_ALY_MESSAGING_SENDER_ID=your_sender_id_here
REACT_APP_FIREBASE_GERENCIADOR_ALY_APP_ID=your_app_id_here

# System Manager Config (usually same as Gerenciador ALY)
REACT_APP_SYSTEM_MANAGER_API_KEY=your_api_key_here
REACT_APP_SYSTEM_MANAGER_AUTH_DOMAIN=your_auth_domain_here
REACT_APP_SYSTEM_MANAGER_PROJECT_ID=your_project_id_here
REACT_APP_SYSTEM_MANAGER_STORAGE_BUCKET=your_storage_bucket_here
REACT_APP_SYSTEM_MANAGER_MESSAGING_SENDER_ID=your_sender_id_here
REACT_APP_SYSTEM_MANAGER_APP_ID=your_app_id_here

# Project Selection
REACT_APP_FIREBASE_PROJECT_KEYS=OBEYON,GERENCIADOR_ALY,ALY_ONEPAGES_RUNTIME
REACT_APP_SYSTEM_MANAGER_PROJECT_ID=gerenciador-aly
REACT_APP_FIREBASE_SHARED_STORAGE_BUCKET=your_shared_storage_bucket_here

# Feature Flags
REACT_APP_VERCEL_ENV_AUTOMATION=false

# Notes:
# - Get these values from Firebase Console > Project Settings
# - DO NOT share or commit real credentials
# - For GitHub Actions/CI, use GitHub Secrets instead
# - Rotate API Keys periodically in Firebase Console
