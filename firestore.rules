rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasSistemaConfig() {
      return exists(/databases/$(database)/documents/add_ons/sistema_config);
    }

    function configuredOwnerUidRuntime() {
      return hasSistemaConfig() &&
        (get(/databases/$(database)/documents/add_ons/sistema_config).data.ownerUid is string)
          ? get(/databases/$(database)/documents/add_ons/sistema_config).data.ownerUid
          : (
              hasSistemaConfig() &&
              (get(/databases/$(database)/documents/add_ons/sistema_config).data.adminUid is string)
                ? get(/databases/$(database)/documents/add_ons/sistema_config).data.adminUid
                : ""
            );
    }

    function isAdminDinamico() {
      return signedIn() &&
        hasSistemaConfig() &&
        configuredOwnerUidRuntime() != "" &&
        request.auth.uid == configuredOwnerUidRuntime();
    }

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.uid == "WnGJjmU6btgKmMMFAQq5Hpupsap1" ||
        isAdminDinamico()
      );
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasOwnSkin(skinId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/skins/$(skinId));
    }

    function hasActiveSkinId() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.skinAtivaId is string);
    }

    function activeSkinId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.skinAtivaId;
    }

    function isSelfOrOwnSkinId(refId) {
      return signedIn() && (refId == request.auth.uid || hasOwnSkin(refId));
    }

    function canReadPublic(visibilidade) {
      return visibilidade == null ||
        visibilidade == "publico" ||
        ((visibilidade == "publico_restritivo" || visibilidade == "privado") && signedIn());
    }

    function canReadSkin(userId, skinId) {
      return isAdmin() ||
        isOwner(userId) ||
        isOneOwnerSkin(userId) ||
        (
          exists(/databases/$(database)/documents/users/$(userId)/skins/$(skinId)) &&
          canReadPublic(
            get(/databases/$(database)/documents/users/$(userId)/skins/$(skinId)).data.visibilidade
          )
        );
    }

    function configuredAdminUid() {
      return configuredOwnerUidRuntime();
    }

    function isOneOwnerPublicEntryMode() {
      return hasSistemaConfig() &&
        (get(/databases/$(database)/documents/add_ons/sistema_config).data.tipoExperiencia is string) &&
        (
          get(/databases/$(database)/documents/add_ons/sistema_config).data.tipoExperiencia == "oneowner" ||
          get(/databases/$(database)/documents/add_ons/sistema_config).data.tipoExperiencia == "onepage"
        ) &&
        (get(/databases/$(database)/documents/add_ons/sistema_config).data.modoAcessoProjeto is string) &&
        (
          get(/databases/$(database)/documents/add_ons/sistema_config).data.modoAcessoProjeto == "publico_sem_login" ||
          get(/databases/$(database)/documents/add_ons/sistema_config).data.modoAcessoProjeto == "publico_com_area_restrita"
        );
    }

    function isOneOwnerSkin(userId) {
      return isOneOwnerPublicEntryMode() &&
        configuredAdminUid() != "" &&
        userId == configuredAdminUid();
    }

    function isEspacoCoCriadorData(data) {
      return signedIn() &&
        (data.coCriadoresUids is list) &&
        data.coCriadoresUids.hasAny([request.auth.uid]);
    }

    function canManageEspacoData(data, userId) {
      return isAdmin() || isOwner(userId) || isEspacoCoCriadorData(data);
    }

    function canManageEspacoByPath(userId, espacoId) {
      return exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)) &&
        canManageEspacoData(
          get(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)).data,
          userId
        );
    }

    function isEspacoAssinante(userId, espacoId) {
      return signedIn() && (
        exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/assinantes/$(request.auth.uid)) ||
        (hasActiveSkinId() &&
          exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/assinantes/$(activeSkinId())))
      );
    }

    function canReadEspacoData(data, userId, espacoId) {
      return canManageEspacoData(data, userId) ||
        data.visibilidade == null ||
        data.visibilidade == "publico" ||
        ((data.visibilidade == "publico_restritivo" || data.visibilidade == "privado") && signedIn()) ||
        (data.visibilidade == "exclusivo_assinante" && isEspacoAssinante(userId, espacoId));
    }

    function canReadEspacoEstruturaData(data, userId, espacoId) {
      return canReadEspacoData(data, userId, espacoId) ||
        isOneOwnerPublicMode();
    }

    function isBlocoCoCriador(data) {
      return signedIn() &&
        (data.coCriadoresUids is list) &&
        data.coCriadoresUids.hasAny([request.auth.uid]);
    }

    function canManageBlocoData(data) {
      return isAdmin() ||
        (signedIn() && (
          data.criadoPor == request.auth.uid ||
          isBlocoCoCriador(data)
        ));
    }

    function isLegacyBlocoComprador(blocoId) {
      return signedIn() && (
        exists(/databases/$(database)/documents/blocos/$(blocoId)/compradores/$(request.auth.uid)) ||
        (hasActiveSkinId() &&
          exists(/databases/$(database)/documents/blocos/$(blocoId)/compradores/$(activeSkinId())))
      );
    }

    function isEspacoBlocoComprador(userId, espacoId, blocoId) {
      return signedIn() && (
        exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)/compradores/$(request.auth.uid)) ||
        (hasActiveSkinId() &&
          exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)/compradores/$(activeSkinId())))
      );
    }

    function canReadLegacyBlocoData(data, blocoId) {
      return canManageBlocoData(data) ||
        data.visibilidade == null ||
        data.visibilidade == "publico" ||
        data.visibilidade == "publico_restritivo" ||
        data.visibilidade == "privado" ||
        data.visibilidade == "exclusivo_assinante" ||
        data.visibilidade == "exclusivo_comprador" ||
        data.visibilidade == "comprado";
    }

    function canReadEspacoBlocoData(data, userId, espacoId, blocoId) {
      return canManageEspacoByPath(userId, espacoId) ||
        canManageBlocoData(data) ||
        (
          exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)) &&
          canReadEspacoData(
            get(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)).data,
            userId,
            espacoId
          ) &&
          (
            data.visibilidade == null ||
            data.visibilidade == "publico" ||
            data.visibilidade == "publico_restritivo" ||
            data.visibilidade == "privado" ||
            data.visibilidade == "exclusivo_assinante" ||
            data.visibilidade == "exclusivo_comprador" ||
            data.visibilidade == "comprado"
          )
        );
    }

    function isOneOwnerPublicMode() {
      return isOneOwnerPublicEntryMode();
    }

    function canWriteBlocosNoProjetoAtual() {
      return !isOneOwnerPublicMode() || isAdmin();
    }

    function hasProjetoSistemaConfig(projectKey) {
      return exists(
        /databases/$(database)/documents/projetos/$(projectKey)/add_ons/sistema_config
      );
    }

    function projetoAdminUid(projectKey) {
      return hasProjetoSistemaConfig(projectKey) &&
        (get(
          /databases/$(database)/documents/projetos/$(projectKey)/add_ons/sistema_config
        ).data.ownerUid is string)
          ? get(
            /databases/$(database)/documents/projetos/$(projectKey)/add_ons/sistema_config
          ).data.ownerUid
          : (
              hasProjetoSistemaConfig(projectKey) &&
              (get(
                /databases/$(database)/documents/projetos/$(projectKey)/add_ons/sistema_config
              ).data.adminUid is string)
                ? get(
                  /databases/$(database)/documents/projetos/$(projectKey)/add_ons/sistema_config
                ).data.adminUid
                : ""
            );
    }

    function isProjetoAdmin(projectKey) {
      return signedIn() &&
        projetoAdminUid(projectKey) != "" &&
        request.auth.uid == projetoAdminUid(projectKey);
    }

    function isProjetoOneOwnerPublicMode(projectKey) {
      return hasProjetoSistemaConfig(projectKey) &&
        (get(
          /databases/$(database)/documents/projetos/$(projectKey)/add_ons/sistema_config
        ).data.tipoExperiencia is string) &&
        (
          get(
            /databases/$(database)/documents/projetos/$(projectKey)/add_ons/sistema_config
          ).data.tipoExperiencia == "oneowner" ||
          get(
            /databases/$(database)/documents/projetos/$(projectKey)/add_ons/sistema_config
          ).data.tipoExperiencia == "onepage"
        ) &&
        (get(
          /databases/$(database)/documents/projetos/$(projectKey)/add_ons/sistema_config
        ).data.modoAcessoProjeto is string) &&
        (
          get(
            /databases/$(database)/documents/projetos/$(projectKey)/add_ons/sistema_config
          ).data.modoAcessoProjeto == "publico_sem_login" ||
          get(
            /databases/$(database)/documents/projetos/$(projectKey)/add_ons/sistema_config
          ).data.modoAcessoProjeto == "publico_com_area_restrita"
        );
    }

    function hasProjetoActiveSkinId(projectKey) {
      return signedIn() &&
        exists(/databases/$(database)/documents/projetos/$(projectKey)/users/$(request.auth.uid)) &&
        (get(
          /databases/$(database)/documents/projetos/$(projectKey)/users/$(request.auth.uid)
        ).data.skinAtivaId is string);
    }

    function projetoActiveSkinId(projectKey) {
      return get(
        /databases/$(database)/documents/projetos/$(projectKey)/users/$(request.auth.uid)
      ).data.skinAtivaId;
    }

    function isProjetoSelfOrOwnSkinId(projectKey, refId) {
      return signedIn() && (
        refId == request.auth.uid ||
        exists(/databases/$(database)/documents/projetos/$(projectKey)/users/$(request.auth.uid)/skins/$(refId))
      );
    }

    function isProjetoEspacoCoCriadorData(data) {
      return signedIn() &&
        (data.coCriadoresUids is list) &&
        data.coCriadoresUids.hasAny([request.auth.uid]);
    }

    function canManageProjetoEspacoData(projectKey, data, userId) {
      return isAdmin() ||
        isProjetoAdmin(projectKey) ||
        isOwner(userId) ||
        isProjetoEspacoCoCriadorData(data);
    }

    function canManageProjetoEspacoByPath(projectKey, userId, espacoId) {
      return exists(
        /databases/$(database)/documents/projetos/$(projectKey)/users/$(userId)/espacos/$(espacoId)
      ) &&
        canManageProjetoEspacoData(
          projectKey,
          get(
            /databases/$(database)/documents/projetos/$(projectKey)/users/$(userId)/espacos/$(espacoId)
          ).data,
          userId
        );
    }

    function isProjetoEspacoAssinante(projectKey, userId, espacoId) {
      return signedIn() && (
        exists(
          /databases/$(database)/documents/projetos/$(projectKey)/users/$(userId)/espacos/$(espacoId)/assinantes/$(request.auth.uid)
        ) ||
        (hasProjetoActiveSkinId(projectKey) &&
          exists(
            /databases/$(database)/documents/projetos/$(projectKey)/users/$(userId)/espacos/$(espacoId)/assinantes/$(projetoActiveSkinId(projectKey))
          ))
      );
    }

    function canReadProjetoEspacoData(projectKey, data, userId, espacoId) {
      return canManageProjetoEspacoData(projectKey, data, userId) ||
        data.visibilidade == null ||
        data.visibilidade == "publico" ||
        ((data.visibilidade == "publico_restritivo" || data.visibilidade == "privado") && signedIn()) ||
        (data.visibilidade == "exclusivo_assinante" && isProjetoEspacoAssinante(projectKey, userId, espacoId));
    }

    function canReadProjetoEspacoEstruturaData(projectKey, data, userId, espacoId) {
      return canReadProjetoEspacoData(projectKey, data, userId, espacoId) ||
        isProjetoOneOwnerPublicMode(projectKey);
    }

    function canReadProjetoBlocoData(projectKey, data, userId, espacoId, blocoId) {
      return canManageProjetoEspacoByPath(projectKey, userId, espacoId) ||
        canManageBlocoData(data) ||
        (
          exists(
            /databases/$(database)/documents/projetos/$(projectKey)/users/$(userId)/espacos/$(espacoId)
          ) &&
          canReadProjetoEspacoData(
            projectKey,
            get(
              /databases/$(database)/documents/projetos/$(projectKey)/users/$(userId)/espacos/$(espacoId)
            ).data,
            userId,
            espacoId
          ) &&
          (
            data.visibilidade == null ||
            data.visibilidade == "publico" ||
            data.visibilidade == "publico_restritivo" ||
            data.visibilidade == "privado" ||
            data.visibilidade == "exclusivo_assinante" ||
            data.visibilidade == "exclusivo_comprador" ||
            data.visibilidade == "comprado"
          )
        );
    }

    function canWriteProjetoBlocos(projectKey) {
      return !isProjetoOneOwnerPublicMode(projectKey) || isAdmin() || isProjetoAdmin(projectKey);
    }

    function canCreateProjetoEspacoBloco(projectKey, userId, espacoId, data) {
      return signedIn() &&
        canWriteProjetoBlocos(projectKey) &&
        canManageProjetoEspacoByPath(projectKey, userId, espacoId) &&
        (!('espacoId' in data) || data.espacoId == espacoId) &&
        (!('ownerUserId' in data) || data.ownerUserId == userId) &&
        (!('criadoPor' in data) || data.criadoPor == request.auth.uid);
    }

    function canCreateEspacoBloco(userId, espacoId, data) {
      return signedIn() &&
        canWriteBlocosNoProjetoAtual() &&
        canManageEspacoByPath(userId, espacoId) &&
        (!('espacoId' in data) || data.espacoId == espacoId) &&
        (!('ownerUserId' in data) || data.ownerUserId == userId) &&
        (!('criadoPor' in data) || data.criadoPor == request.auth.uid);
    }

    function canManageLegacyBloco(blocoId) {
      return exists(/databases/$(database)/documents/blocos/$(blocoId)) &&
        canManageBlocoData(get(/databases/$(database)/documents/blocos/$(blocoId)).data);
    }

    function isContatoParticipantData(data) {
      return signedIn() &&
        (
          ((data.participantUids is list) && data.participantUids.hasAny([request.auth.uid])) ||
          ((data.ownerUserId is string) && data.ownerUserId == request.auth.uid) ||
          ((data.compradorUid is string) && data.compradorUid == request.auth.uid)
        );
    }

    function canAccessContatoData(data) {
      return isAdmin() || isContatoParticipantData(data);
    }

    function canJoinLiveContatoData(resourceData, requestData) {
      return signedIn() &&
        (resourceData.tipo is string) &&
        resourceData.tipo == "live" &&
        (requestData.idContato is string) &&
        requestData.idContato == resourceData.idContato &&
        (!('tipo' in requestData) || requestData.tipo == "live");
    }

    function canAccessContatoById(contatoId) {
      return isAdmin() ||
        (
          signedIn() &&
          exists(/databases/$(database)/documents/contatos/$(contatoId)) &&
          isContatoParticipantData(
            get(/databases/$(database)/documents/contatos/$(contatoId)).data
          )
        );
    }

    function isProjetoContatoParticipantData(projectKey, data) {
      return signedIn() &&
        (
          ((data.participantUids is list) && data.participantUids.hasAny([request.auth.uid])) ||
          ((data.ownerUserId is string) && data.ownerUserId == request.auth.uid) ||
          ((data.compradorUid is string) && data.compradorUid == request.auth.uid) ||
          isProjetoAdmin(projectKey)
        );
    }

    function canAccessProjetoContatoData(projectKey, data) {
      return isAdmin() || isProjetoContatoParticipantData(projectKey, data);
    }

    function canJoinProjetoLiveContatoData(projectKey, resourceData, requestData) {
      return signedIn() &&
        (resourceData.tipo is string) &&
        resourceData.tipo == "live" &&
        (requestData.idContato is string) &&
        requestData.idContato == resourceData.idContato &&
        (!('tipo' in requestData) || requestData.tipo == "live");
    }

    function canAccessProjetoContatoById(projectKey, contatoId) {
      return isAdmin() ||
        isProjetoAdmin(projectKey) ||
        (
          signedIn() &&
          exists(/databases/$(database)/documents/projetos/$(projectKey)/contatos/$(contatoId)) &&
          isProjetoContatoParticipantData(
            projectKey,
            get(
              /databases/$(database)/documents/projetos/$(projectKey)/contatos/$(contatoId)
            ).data
          )
        );
    }

    match /acessos/{acessoId} {
      allow get, list: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /usuarios_projetos/{usuarioProjetoId} {
      allow get, list: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isAdmin() || isOwner(userId);
      allow update, delete: if isAdmin() || isOwner(userId);

      match /logins/{loginId} {
        allow read, write: if isAdmin() || isOwner(userId);
      }

      match /navegacoes_users/{sessaoId} {
        allow read, write: if isAdmin() || isOwner(userId);
      }

      match /integracoes/{integracaoId} {
        allow read: if isAdmin() ||
          isOwner(userId) ||
          (signedIn() && integracaoId == "pixManual");
        allow write: if isAdmin() || isOwner(userId);
      }

      match /pedidos/{pedidoId} {
        allow read: if isAdmin() ||
          isOwner(userId) ||
          (signedIn() && resource.data.compradorUid == request.auth.uid);
        allow create: if signedIn() &&
          request.resource.data.ownerUserId == userId &&
          request.resource.data.compradorUid == request.auth.uid &&
          request.resource.data.status == "pedido_solicitado";
        allow update, delete: if isAdmin() || isOwner(userId);
      }

      match /skins/{skinId} {
        allow get, list: if isAdmin() ||
          isOwner(userId) ||
          isOneOwnerSkin(userId) ||
          (signedIn() && resource.data.ownerUserId == request.auth.uid) ||
          canReadPublic(resource.data.visibilidade);
        allow create: if isAdmin() ||
          (isOwner(userId) && request.resource.data.ownerUserId == userId);
        allow update, delete: if isAdmin() || isOwner(userId);

        match /{subPath=**} {
          allow read: if canReadSkin(userId, skinId);
          allow write: if isAdmin() || isOwner(userId);
        }
      }

      match /espacos/{espacoId} {
        allow get, list: if canReadEspacoEstruturaData(resource.data, userId, espacoId);
        allow create: if isAdmin() ||
          (isOwner(userId) &&
            (!('ownerUserId' in request.resource.data) || request.resource.data.ownerUserId == userId));
        allow update, delete: if canManageEspacoData(resource.data, userId);

        match /blocos/{blocoId} {
          allow get, list: if canReadEspacoBlocoData(resource.data, userId, espacoId, blocoId);
          allow create: if isAdmin() || canCreateEspacoBloco(userId, espacoId, request.resource.data);
          allow update, delete: if isAdmin() ||
            (canWriteBlocosNoProjetoAtual() && (
            canManageEspacoByPath(userId, espacoId) ||
            canManageBlocoData(resource.data)
            ));

          match /cards/{cardId} {
            allow read: if exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)) &&
              canReadEspacoBlocoData(
                get(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)).data,
                userId,
                espacoId,
                blocoId
              );
            allow create, update, delete: if isAdmin() ||
              (canWriteBlocosNoProjetoAtual() && (
              canManageEspacoByPath(userId, espacoId) ||
              (
                exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)) &&
                canManageBlocoData(
                  get(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)).data
                )
              )
              ));

            match /addOnsRefs/{addOnRefId} {
              allow read: if exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)) &&
                canReadEspacoBlocoData(
                  get(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)).data,
                  userId,
                  espacoId,
                  blocoId
                );
              allow create, update, delete: if isAdmin() ||
                (canWriteBlocosNoProjetoAtual() && (
                canManageEspacoByPath(userId, espacoId) ||
                (
                  exists(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)) &&
                  canManageBlocoData(
                    get(/databases/$(database)/documents/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)).data
                  )
                )
                ));
            }
          }

          match /compradores/{compradorId} {
            allow read: if canManageEspacoByPath(userId, espacoId) || isSelfOrOwnSkinId(compradorId);
            allow create, delete: if canManageEspacoByPath(userId, espacoId) || isSelfOrOwnSkinId(compradorId);
            allow update: if canManageEspacoByPath(userId, espacoId);
          }
        }

        match /assinantes/{assinanteId} {
          allow read: if canManageEspacoByPath(userId, espacoId) || isSelfOrOwnSkinId(assinanteId);
          allow create, delete: if canManageEspacoByPath(userId, espacoId) || isSelfOrOwnSkinId(assinanteId);
          allow update: if canManageEspacoByPath(userId, espacoId);
          }
        }
      }

      match /espacos_publicos/{espacoId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin() || isOwner(userId);
      }

    match /blocos/{blocoId} {
      allow read: if canReadLegacyBlocoData(resource.data, blocoId);
      allow create: if canWriteBlocosNoProjetoAtual() &&
        signedIn() &&
        (isAdmin() || request.resource.data.criadoPor == request.auth.uid);
      allow update, delete: if canWriteBlocosNoProjetoAtual() &&
        canManageBlocoData(resource.data);

      match /cards/{cardId} {
        allow read: if exists(/databases/$(database)/documents/blocos/$(blocoId)) &&
          canReadLegacyBlocoData(
            get(/databases/$(database)/documents/blocos/$(blocoId)).data,
            blocoId
          );
        allow create, update, delete: if canWriteBlocosNoProjetoAtual() &&
          canManageLegacyBloco(blocoId);

        match /addOnsRefs/{addOnRefId} {
          allow read: if exists(/databases/$(database)/documents/blocos/$(blocoId)) &&
            canReadLegacyBlocoData(
              get(/databases/$(database)/documents/blocos/$(blocoId)).data,
              blocoId
            );
          allow create, update, delete: if canWriteBlocosNoProjetoAtual() &&
            canManageLegacyBloco(blocoId);
        }
      }

      match /compradores/{compradorId} {
        allow read: if canManageLegacyBloco(blocoId) || isSelfOrOwnSkinId(compradorId);
        allow create, delete: if canManageLegacyBloco(blocoId) || isSelfOrOwnSkinId(compradorId);
        allow update: if canManageLegacyBloco(blocoId);
      }
    }

    match /contatos/{contatoId} {
      allow create: if signedIn();
      allow read: if canAccessContatoData(resource.data);
      allow update: if canAccessContatoData(resource.data) ||
        canJoinLiveContatoData(resource.data, request.resource.data);
      allow delete: if canAccessContatoData(resource.data);

      match /conversas/{conversaId} {
        allow create, read, update, delete: if canAccessContatoById(contatoId);

        match /chat/{chatId} {
          allow create, read, update, delete: if canAccessContatoById(contatoId);
        }

        // Compatibilidade com legado que ainda usa "chats".
        match /chats/{chatId} {
          allow create, read, update, delete: if canAccessContatoById(contatoId);
        }

        // Sinalizacao WebRTC para live (ofertas/respostas e ICE candidates).
        match /webrtc/{peerId} {
          allow create, read, update, delete: if canAccessContatoById(contatoId);

          match /viewerCandidates/{candidateId} {
            allow create, read, update, delete: if canAccessContatoById(contatoId);
          }

          match /hostCandidates/{candidateId} {
            allow create, read, update, delete: if canAccessContatoById(contatoId);
          }
        }
      }
    }

    match /acessos/{acessoId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /add_ons/{addonId} {
      allow read: if true;
      allow create: if isAdmin() || (
        addonId == "sistema_config" &&
        signedIn() &&
        !hasSistemaConfig() &&
        (
          request.resource.data.ownerUid == request.auth.uid ||
          request.resource.data.adminUid == request.auth.uid
        )
      );
      allow update, delete: if isAdmin();
    }

    // Cadastro central de sistemas (projeto gerenciador).
    // Leitura publica para carregar configuracoes globais sem login.
    match /systems/{systemId} {
      allow read: if true;
      allow create: if isAdmin() || (
        signedIn() &&
        (request.resource.data.criadoPorUid is string) &&
        request.resource.data.criadoPorUid == request.auth.uid &&
        (request.resource.data.atualizadoPorUid is string) &&
        request.resource.data.atualizadoPorUid == request.auth.uid
      );
      allow update, delete: if isAdmin() || (
        signedIn() &&
        (
          (
            (resource.data.criadoPorUid is string) &&
            resource.data.criadoPorUid == request.auth.uid
          ) ||
          (
            !(resource.data.criadoPorUid is string) &&
            (request.resource.data.criadoPorUid is string) &&
            request.resource.data.criadoPorUid == request.auth.uid &&
            (request.resource.data.atualizadoPorUid is string) &&
            request.resource.data.atualizadoPorUid == request.auth.uid
          )
        )
      );
    }

    match /iconCollections/{collectionId} {
      allow read: if true;
      allow create: if isAdmin() || (
        signedIn() &&
        (request.resource.data.criadoPorUid is string) &&
        request.resource.data.criadoPorUid == request.auth.uid &&
        (request.resource.data.atualizadoPorUid is string) &&
        request.resource.data.atualizadoPorUid == request.auth.uid
      );
      allow update, delete: if isAdmin() || (
        signedIn() &&
        (
          (
            (resource.data.criadoPorUid is string) &&
            resource.data.criadoPorUid == request.auth.uid
          ) ||
          (
            !(resource.data.criadoPorUid is string) &&
            (request.resource.data.criadoPorUid is string) &&
            request.resource.data.criadoPorUid == request.auth.uid &&
            (request.resource.data.atualizadoPorUid is string) &&
            request.resource.data.atualizadoPorUid == request.auth.uid
          )
        )
      );
    }

    // Namespace de dados por projeto (oneowners em runtime compartilhado).
    match /projetos/{projectKey} {
      match /add_ons/{addonId} {
        allow read: if true;
        allow create: if isAdmin() || (
          addonId == "sistema_config" &&
          signedIn() &&
          (
            request.resource.data.ownerUid == request.auth.uid ||
            request.resource.data.adminUid == request.auth.uid
          )
        );
        allow update, delete: if isAdmin() || isProjetoAdmin(projectKey);
      }

      match /users/{userId} {
        allow read, create, update, delete: if isAdmin() || isProjetoAdmin(projectKey) || isOwner(userId);

        match /logins/{loginId} {
          allow read, write: if isAdmin() || isProjetoAdmin(projectKey) || isOwner(userId);
        }

        match /navegacoes_users/{sessaoId} {
          allow read, write: if isAdmin() || isProjetoAdmin(projectKey) || isOwner(userId);
        }

        match /integracoes/{integracaoId} {
          allow read: if isAdmin() ||
            isProjetoAdmin(projectKey) ||
            isOwner(userId) ||
            (signedIn() && integracaoId == "pixManual");
          allow write: if isAdmin() || isProjetoAdmin(projectKey) || isOwner(userId);
        }

        match /pedidos/{pedidoId} {
          allow read: if isAdmin() ||
            isProjetoAdmin(projectKey) ||
            isOwner(userId) ||
            (signedIn() && resource.data.compradorUid == request.auth.uid);
          allow create: if signedIn() &&
            request.resource.data.ownerUserId == userId &&
            request.resource.data.compradorUid == request.auth.uid &&
            request.resource.data.status == "pedido_solicitado";
          allow update, delete: if isAdmin() || isProjetoAdmin(projectKey) || isOwner(userId);
        }

        match /skins/{skinId} {
          allow get, list: if isAdmin() ||
            isProjetoAdmin(projectKey) ||
            isOwner(userId) ||
            (signedIn() && resource.data.ownerUserId == request.auth.uid) ||
            canReadPublic(resource.data.visibilidade);
          allow create: if isAdmin() ||
            isProjetoAdmin(projectKey) ||
            (isOwner(userId) && request.resource.data.ownerUserId == userId);
          allow update, delete: if isAdmin() || isProjetoAdmin(projectKey) || isOwner(userId);

          match /{subPath=**} {
            allow read: if isAdmin() ||
              isProjetoAdmin(projectKey) ||
              isOwner(userId) ||
              (
                exists(
                  /databases/$(database)/documents/projetos/$(projectKey)/users/$(userId)/skins/$(skinId)
                ) &&
                canReadPublic(
                  get(
                    /databases/$(database)/documents/projetos/$(projectKey)/users/$(userId)/skins/$(skinId)
                  ).data.visibilidade
                )
              );
            allow write: if isAdmin() || isProjetoAdmin(projectKey) || isOwner(userId);
          }
        }

        match /espacos/{espacoId} {
          allow get, list: if canReadProjetoEspacoEstruturaData(projectKey, resource.data, userId, espacoId);
          allow create: if isAdmin() ||
            isProjetoAdmin(projectKey) ||
            (isOwner(userId) &&
              (!('ownerUserId' in request.resource.data) || request.resource.data.ownerUserId == userId));
          allow update, delete: if canManageProjetoEspacoData(projectKey, resource.data, userId);

          match /blocos/{blocoId} {
            allow get, list: if canReadProjetoBlocoData(projectKey, resource.data, userId, espacoId, blocoId);
            allow create: if isAdmin() || canCreateProjetoEspacoBloco(projectKey, userId, espacoId, request.resource.data);
            allow update, delete: if isAdmin() ||
              (canWriteProjetoBlocos(projectKey) && (
                canManageProjetoEspacoByPath(projectKey, userId, espacoId) ||
                canManageBlocoData(resource.data)
              ));

            match /cards/{cardId} {
              allow read: if exists(
                /databases/$(database)/documents/projetos/$(projectKey)/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)
              ) &&
                canReadProjetoBlocoData(
                  projectKey,
                  get(
                    /databases/$(database)/documents/projetos/$(projectKey)/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)
                  ).data,
                  userId,
                  espacoId,
                  blocoId
                );
              allow create, update, delete: if isAdmin() ||
                (canWriteProjetoBlocos(projectKey) && (
                  canManageProjetoEspacoByPath(projectKey, userId, espacoId) ||
                  (
                    exists(
                      /databases/$(database)/documents/projetos/$(projectKey)/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)
                    ) &&
                    canManageBlocoData(
                      get(
                        /databases/$(database)/documents/projetos/$(projectKey)/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)
                      ).data
                    )
                  )
                ));

              match /addOnsRefs/{addOnRefId} {
                allow read: if exists(
                  /databases/$(database)/documents/projetos/$(projectKey)/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)
                ) &&
                  canReadProjetoBlocoData(
                    projectKey,
                    get(
                      /databases/$(database)/documents/projetos/$(projectKey)/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)
                    ).data,
                    userId,
                    espacoId,
                    blocoId
                  );
                allow create, update, delete: if isAdmin() ||
                  (canWriteProjetoBlocos(projectKey) && (
                    canManageProjetoEspacoByPath(projectKey, userId, espacoId) ||
                    (
                      exists(
                        /databases/$(database)/documents/projetos/$(projectKey)/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)
                      ) &&
                      canManageBlocoData(
                        get(
                          /databases/$(database)/documents/projetos/$(projectKey)/users/$(userId)/espacos/$(espacoId)/blocos/$(blocoId)
                        ).data
                      )
                    )
                  ));
              }
            }

            match /compradores/{compradorId} {
              allow read: if canManageProjetoEspacoByPath(projectKey, userId, espacoId) ||
                isProjetoSelfOrOwnSkinId(projectKey, compradorId);
              allow create, delete: if canManageProjetoEspacoByPath(projectKey, userId, espacoId) ||
                isProjetoSelfOrOwnSkinId(projectKey, compradorId);
              allow update: if canManageProjetoEspacoByPath(projectKey, userId, espacoId);
            }
          }

          match /assinantes/{assinanteId} {
            allow read: if canManageProjetoEspacoByPath(projectKey, userId, espacoId) ||
              isProjetoSelfOrOwnSkinId(projectKey, assinanteId);
            allow create, delete: if canManageProjetoEspacoByPath(projectKey, userId, espacoId) ||
              isProjetoSelfOrOwnSkinId(projectKey, assinanteId);
            allow update: if canManageProjetoEspacoByPath(projectKey, userId, espacoId);
          }
        }

        match /espacos_publicos/{espacoId} {
          allow get, list: if true;
          allow create, update, delete: if isAdmin() || isProjetoAdmin(projectKey) || isOwner(userId);
        }
      }

      match /contatos/{contatoId} {
        allow create: if signedIn();
        allow read: if canAccessProjetoContatoData(projectKey, resource.data);
        allow update: if canAccessProjetoContatoData(projectKey, resource.data) ||
          canJoinProjetoLiveContatoData(projectKey, resource.data, request.resource.data);
        allow delete: if canAccessProjetoContatoData(projectKey, resource.data);

        match /conversas/{conversaId} {
          allow create, read, update, delete: if canAccessProjetoContatoById(projectKey, contatoId);

          match /chat/{chatId} {
            allow create, read, update, delete: if canAccessProjetoContatoById(projectKey, contatoId);
          }

          match /chats/{chatId} {
            allow create, read, update, delete: if canAccessProjetoContatoById(projectKey, contatoId);
          }

          // Sinalizacao WebRTC para live (ofertas/respostas e ICE candidates).
          match /webrtc/{peerId} {
            allow create, read, update, delete: if canAccessProjetoContatoById(projectKey, contatoId);

            match /viewerCandidates/{candidateId} {
              allow create, read, update, delete: if canAccessProjetoContatoById(projectKey, contatoId);
            }

            match /hostCandidates/{candidateId} {
              allow create, read, update, delete: if canAccessProjetoContatoById(projectKey, contatoId);
            }
          }
        }
      }
    }

    // Necessario para consultas collectionGroup("skins")
    // em qualquer profundidade de caminho.
    match /{path=**}/skins/{skinId} {
      allow get, list: if isAdmin() ||
        (signedIn() && resource.data.ownerUserId == request.auth.uid) ||
        canReadPublic(resource.data.visibilidade);
    }

    match /{doc=**} {
      allow read, write: if false;
    }
  }
}

