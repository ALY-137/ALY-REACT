rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        request.auth.uid == "WnGJjmU6btgKmMMFAQq5Hpupsap1";
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /imagens/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Branding do projeto (logo do login, favicon e ativos semelhantes).
    // A leitura precisa ser publica porque a tela de login usa esses assets
    // antes da autenticacao. Escrita fica restrita ao dono do path ou admin.
    match /branding/{projectKey}/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() || isOwner(userId);
    }

    // Compatibilidade legado: caminho antigo.
    match /users/{userId}/blocos/{allPaths=**} {
      allow read, write: if isAdmin() || isOwner(userId);
    }

    // Preview desfocado: sempre publico para exibir bloqueio sem vazar original.
    match /users/{userId}/espacos/{espacoId}/blocos/{blocoId}/preview/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() || isOwner(userId);
    }

    // Original: protegido para anonimos.
    // Visitante deslogado usa URL tokenizada persistida no documento do bloco publico.
    match /users/{userId}/espacos/{espacoId}/blocos/{blocoId}/original/{allPaths=**} {
      allow read: if isAdmin() || isOwner(userId) || signedIn();
      allow write: if isAdmin() || isOwner(userId);
    }

    // Imagens de cards dentro do bloco:
    // users/{ownerUserId}/espacos/{espacoId}/blocos/{blocoId}/cards/{cardId}/{arquivo}
    match /users/{userId}/espacos/{espacoId}/blocos/{blocoId}/cards/{cardId}/{allPaths=**} {
      // Mantem leitura publica para cards de blocos publicos.
      // Se quiser endurecer, troque para: isAdmin() || isOwner(userId) || signedIn()
      allow read: if true;
      allow write: if isAdmin() || isOwner(userId);
    }

    // Live banner e demais ativos publicos da live.
    match /users/{userId}/espacos/{espacoId}/blocos/{blocoId}/live/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() || isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
