rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        request.auth.uid == "WnGJjmU6btgKmMMFAQq5Hpupsap1";
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /imagens/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Compatibilidade legado: caminho antigo.
    match /users/{userId}/blocos/{allPaths=**} {
      allow read, write: if isAdmin() || isOwner(userId);
    }

    // Preview desfocado: sempre publico para exibir bloqueio sem vazar original.
    match /users/{userId}/espacos/{espacoId}/blocos/{blocoId}/preview/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() || isOwner(userId);
    }

    // Original: protegido para anonimos.
    // Visitante deslogado usa URL tokenizada persistida no documento do bloco publico.
    match /users/{userId}/espacos/{espacoId}/blocos/{blocoId}/original/{allPaths=**} {
      allow read: if isAdmin() || isOwner(userId) || signedIn();
      allow write: if isAdmin() || isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
